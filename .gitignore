# ---- Secrets. Never version these. ----
#
# The pattern is deliberately wide. `.env` and `.env.local` on their own let
# through everything else that accumulates around a secrets file — `.env.bak`,
# `.env.old`, `.env.2026-08-09`, `.env.producao`. One of them is enough for the
# keys to escape, and you only find out after the commit exists.
#
# So the whole family is ignored, with one explicit exception for the file that
# does travel.
.env
.env.*
*.env
!.env.example

# ---- Preparation material: environment snapshots and references ----
# Stays on disk; does not travel in the package.
_prep/

# ---- Virtual environments ----
.venv/
.venvs/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- Datasets: downloaded by scripts/fetch_datasets.py ----
data/

# ---- Run artefacts: produced by whoever runs the pipeline ----
artifacts/
artifacts_variant/

# ---- Logs ----
*.log
logs/

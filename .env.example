# =============================================================================
# graph_based_rag — configuration file
#
#   cp .env.example .env    then fill it in.
#
# This file is a SECURITY matter, not a housekeeping one. It is where someone
# can, without noticing, point this repository at the databases and graphs of
# the original experimental phase — which hold the indexes and the 4,000
# judgements the thesis rests on, and which this code would write to without
# complaining, because as far as the program is concerned it is a legitimate
# connection.
#
# There is a brake (`benchmark.infra.guard`) that refuses the original
# environment's ports, but it protects against known ports, not against
# everything. If you received this package on a machine that never had that
# environment, there is nothing to worry about: fill it in and run.
#
# THIS REPOSITORY'S PORTS — the ones in docker-compose.yml:
#   benchmark Postgres  15432
#   Cognee Postgres     15433
#   Neo4j               18xxx band
#
# NEVER put back 5432, 5433, 7689 or the 17xxx band: those belong to the
# original environment.
#
# Every variable below is marked:
#   [REQUIRED]   without it the pipeline does not run
#   [OPTIONAL]   has a default that works
#   [DO NOT CHANGE]  the default is correct; changing it changes the experiment
# =============================================================================


# -----------------------------------------------------------------------------
# 1. THE VARIABLE THAT DEFINES THE WHOLE EXPERIMENT
# -----------------------------------------------------------------------------
# This is the single-variable switch between the thesis's two arms, and the ONLY
# thing that changes between them is the instruction given to the reader. Set it
# wrong and you silently produce a different experiment under the same name —
# the output files do not tell one from the other.
#
#   v2 (default)  GROUNDED reader: answers only from the retrieved context, and
#                 is instructed to abstain when that context is not enough. This
#                 is the controlled arm, and what the thesis reports.
#   v1            FREE reader: may fall back on the model's parametric knowledge
#                 and never declines. Also accepts off, free, 0, no, none.
#
# Leaving it empty means v2. Only change this if you know you want the other arm.
# [DO NOT CHANGE]
READER_GROUNDING=v2


# -----------------------------------------------------------------------------
# 2. OPENAI — the only API actually used
# -----------------------------------------------------------------------------
# Indexing, reading and judging all use OpenAI. Keys for other providers you may
# have seen mentioned elsewhere in this project are NOT read by any code path in
# this package — checked on 2026-08-09 — and so they are not here. Do not fill
# them in.

# [REQUIRED] Without this the judge fails immediately (KeyError) and indexing has
# nothing to generate embeddings with.
OPENAI_API_KEY=

# [REQUIRED] The default is "fake", which returns synthetic answers and exists
# only for the test suite. For a real run it has to be "openai".
MODEL_PROVIDER=openai

# [REQUIRED in practice] Without values, the model-dependent methods do not
# resolve. These are the thesis's:
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# [DO NOT CHANGE] The Responses API exposes no seed, so temperature 0 is the only
# determinism control the reader has.
OPENAI_CHAT_TEMPERATURE=0.0


# -----------------------------------------------------------------------------
# 3. BENCHMARK POSTGRES — answers, judgements, embeddings
# -----------------------------------------------------------------------------
# [REQUIRED] Matches the `postgres` service in docker-compose.yml.
# Port 15432 is not decorative: 5432 is the Postgres holding the thesis's
# judgements, and the brake refuses it while the original environment is present
# on the machine.
DATABASE_URL=postgresql://benchmark:benchmark@localhost:15432/benchmark


# -----------------------------------------------------------------------------
# 4. NEO4J — Microsoft GraphRAG and LightRAG
# -----------------------------------------------------------------------------
# These match the `neo4j_graphrag` and `neo4j_lightrag` services in
# docker-compose.yml. The 18xxx band.
#
# WARNING: `bolt://localhost:17687` and the 17xxx band belong to the original
# environment's containers, which hold the thesis indexes. The brake refuses
# them always, on any machine.

# [OPTIONAL] These are the code's own defaults.
GRAPHRAG_NEO4J_URI=bolt://localhost:18687
GRAPHRAG_NEO4J_USER=neo4j
GRAPHRAG_NEO4J_PASSWORD=benchmark_graphrag
GRAPHRAG_NEO4J_DATABASE=neo4j

LIGHTRAG_NEO4J_URI=bolt://localhost:18688
LIGHTRAG_NEO4J_USER=neo4j
LIGHTRAG_NEO4J_PASSWORD=benchmark_lightrag
LIGHTRAG_NEO4J_DATABASE=neo4j


# -----------------------------------------------------------------------------
# 5. LIGHTRAG — the variable that keeps memory from blowing up
# -----------------------------------------------------------------------------
# [REQUIRED for LightRAG] Without this, LightRAG builds one RAG object per
# question and runs out of memory. It cost lost runs. Accepts 1, true, yes, on.
LIGHTRAG_REUSE_RAG=1

# [OPTIONAL] Context mode for the LightRAG reader. Defaults to "chunks", which is
# the behaviour the thesis used. Alternatives: "native_context", "structured".
# LIGHTRAG_READER_CONTEXT=chunks

# [OPTIONAL] Retrieval width for the LightRAG native arm. Empty uses the
# configured top_k; "default"/"lib" lets the library decide; an integer pins it.
# LIGHTRAG_NATIVE_TOPK=


# -----------------------------------------------------------------------------
# 6. COGNEE — only needed in `full` mode
# -----------------------------------------------------------------------------
# Cognee has its own relational and vector stores, separate from the benchmark's,
# in the compose service `postgres_cognee` (port 15433).
#
# The variables Cognee actually consumes — GRAPH_DATABASE_*, DB_*, VECTOR_DB_*,
# BAML_* — do NOT go here: they are derived from configs/methods/cognee.yaml and
# written by the code into the subprocess environment. Putting values here does
# nothing.

# [REQUIRED in full mode] Passwords.
COGNEE_NEO4J_PASSWORD=
COGNEE_POSTGRES_PASSWORD=benchmark

# [OPTIONAL] These override what is in configs/methods/cognee.yaml.
# COGNEE_POSTGRES_HOST=127.0.0.1
# COGNEE_POSTGRES_PORT=15433
# COGNEE_POSTGRES_USER=benchmark
# COGNEE_POSTGRES_DB=
# COGNEE_POSTGRES_SCHEMA=cognee

# [OPTIONAL] Cognee's vector store. Empty means it inherits COGNEE_POSTGRES_*.
# COGNEE_VECTOR_PROVIDER=pgvector
# COGNEE_VECTOR_DB_HOST=
# COGNEE_VECTOR_DB_PORT=
# COGNEE_VECTOR_DB_USER=
# COGNEE_VECTOR_DB_PASSWORD=
# COGNEE_VECTOR_DB_NAME=
# COGNEE_VECTOR_DB_SCHEMA=

# [OPTIONAL] Model overrides for Cognee only. Empty means Cognee inherits the
# OPENAI_* values from section 2. Fill these in only to run it with a different
# model from the rest of the benchmark.
# LLM_PROVIDER=
# LLM_MODEL=
# LLM_API_KEY=
# EMBEDDING_PROVIDER=
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=
# EMBEDDING_API_KEY=
# LITELLM_API_KEY=


# -----------------------------------------------------------------------------
# 7. ISOLATED ENVIRONMENTS — only needed in `full` mode
# -----------------------------------------------------------------------------
# HippoRAG 2 and Microsoft GraphRAG run as subprocesses in venvs of their own,
# because their dependencies fight with the main environment's (neo4j-driver 6.x
# against the neo4j<6 Cognee requires, among others).
#
# [OPTIONAL] The defaults are relative to the working directory and work if the
# venvs are where bootstrap puts them. Fill these in only if yours are
# elsewhere.
# HIPPORAG2_VENV_PYTHON=.venvs/hipporag2/bin/python
# GRAPHRAG_VENV_PYTHON=.venvs/graphrag/bin/python

# [OPTIONAL] Runner paths. Do not touch without a reason.
# HIPPORAG2_INDEX_RUNNER=scripts/hipporag2_index_runner.py
# HIPPORAG2_QUERY_RUNNER=scripts/hipporag2_query_runner.py
# GRAPHRAG_QUERY_RUNNER=scripts/graphrag_query_runner.py


# -----------------------------------------------------------------------------
# 8. PATHS AND ENVIRONMENT
# -----------------------------------------------------------------------------
# [OPTIONAL] Relative to the repository root. The defaults work.
# DATA_DIR=data
# ARTIFACTS_DIR=artifacts
# CONFIG_DIR=configs
# BENCHMARK_ENV=local


# -----------------------------------------------------------------------------
# 9. THE BRAKE — leave it alone, with one exception
# -----------------------------------------------------------------------------
# The brake locates the original experimental repository to decide whether it
# should also refuse the default Postgres (5432/5433) and Neo4j (7474/7687)
# ports. It looks for it through this variable and — if the variable is unset —
# for a sibling of this repository carrying the signature of four directories:
# `artifacts/`, `artifacts_variant/`, `status/` and `writing/`.
#
# If you received this package and never had the original environment: DO NOT
# FILL THIS IN. The detection finds nothing, and 5432 stays yours, as it should.
#
# Set to EMPTY, it explicitly declares that there is no original environment and
# switches that second level off. The 17xxx band and 7689 stay refused either
# way.
# BENCHMARK_AMBIENTE_ORIGINAL=


# =============================================================================
# A NOTE ABOUT VARIABLES THAT NO LONGER EXIST
#
# If you are starting from an old `.env` for this project, these are read by no
# code path at all and can be deleted:
#
#   GOOGLE_API_KEY, GOOGLE_CHAT_MODEL, OPENROUTER_API_KEY, OPENROUTER_CHAT_MODEL,
#   AZURE_OPENAI_*  — no provider other than OpenAI is used
#
#   ENABLE_LLM_AS_JUDGE, ENABLE_REAL_EMBEDDINGS, ENABLE_REAL_LLM,
#   DEFAULT_DATASET, DEFAULT_DATASET_VERSION, DEFAULT_TOP_K,
#   DEFAULT_MAX_CONTEXT_TOKENS, MAX_SAMPLE_SIZE, LOG_LEVEL, ENVIRONMENT,
#   POSTGRES_DB, POSTGRES_HOST, POSTGRES_PASSWORD, POSTGRES_PORT,
#   POSTGRES_USER  — replaced by file configuration, by DATABASE_URL, or
#                     simply abandoned
#
#   OPENAI_TEMPERATURE     → now called OPENAI_CHAT_TEMPERATURE
#   OPENAI_MAX_OUTPUT_TOKENS — not read
#
# Settings loading ignores unknown variables silently (`extra="ignore"`), so an
# `.env` with these in it raises no error — it just does nothing. That is exactly
# why they are listed here.
# =============================================================================
